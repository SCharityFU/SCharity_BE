{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "dist/entities/**"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "src/app.ts" },
    { "source": "/health", "destination": "src/app.ts" },
    { "source": "/api-docs(.*)", "destination": "src/app.ts" },
    { "source": "/(.*)", "destination": "src/app.ts" }
  ]
}
